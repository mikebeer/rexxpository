#!/bin/sh
# RXPIP launcher for ooRexx. Classic-REXX packages (SOURCE/any) are shared
# with the Regina client: same ~/.rxpip store, same credentials.
# ooRexx passes the command line as ONE string, so every argument is
# double-quoted here and split again inside rxpip.rexx.
# rxpip.rexx is either next to this launcher (downloaded from the website)
# or one level up (the repository layout)
D=$(cd "$(dirname "$0")" && pwd)
[ -f "$D/rxpip.rexx" ] || D=$(cd "$D/.." && pwd)
q=""
for a in "$@"; do
  e=$(printf '%s' "$a" | sed 's/\\/\\\\/g; s/"/\\"/g')
  q="$q \"$e\""
done
RXPIP_CLIENT_DIR=$D RXPIP_QUOTED=1 RXPIP_INTERPRETER=${RXPIP_INTERPRETER:-rexx} exec rexx "$D/rxpip.rexx" "$q"
