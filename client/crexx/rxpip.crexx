/* ---------------------------------------------------------------------
   RXPIP  --  the REXX package manager (cREXX client, Level B)
   ---------------------------------------------------------------------
   Same commands, protocol and messages as the Regina client.

   * Packages for cREXX are cREXX Level B source (.crexx modules with a
     namespace) published as   SOURCE / crexx .
   * 'run' compiles your program with rxc against the installed modules,
     assembles everything with rxas and starts it with rxvm. 'build'
     leaves the .rxbin files next to the output name.
   * Local state: $RXPIP_HOME (default ~/.rxpip). config.txt,
     credentials.txt and cache/ are shared with the other clients;
     packages live in <home>/crexx/ (installed.txt, lib/, pkgs/).
   * Requests use curl and archives tar, started with an argument vector
     (no shell, so no quoting problems). Secrets travel in a private
     header file, never on a command ln.
   * Needs rxc, rxas and rxvm on the PATH (or CREXX_HOME/bin) for run/build.
   --------------------------------------------------------------------- */
options levelb
namespace rxpip expose home lang repoUrl NL SOH lastrc upgrade tgtDir recDir isGlobal forceOw readToken clientHdr noNative skipRt instFail
import rxfnsb

main: procedure = .int
  arg a = .string[]
  NL = '0A'x
  SOH = '01'x
  lang = 'crexx'
  lastrc = 0
  upgrade = 0
  forceOw = 0
  noNative = 0
  skipRt = 0
  instFail = 0
  if getenv('RXPIP_NO_NATIVE') = '1' then noNative = 1
  if getenv('RXPIP_SKIP_RUNTIME_CHECK') = '1' then skipRt = 1
  readToken = ''
  clientHdr = ''
  isGlobal = 0
  tgtDir = ''
  recDir = ''
  home = getenv('RXPIP_HOME')
  if home = '' then do
    h = getenv('HOME')
    if h = '' then h = getenv('USERPROFILE')
    home = translate(h, '/', '5C'x) || '/.rxpip'
  end
  call mkdirs(home || '/cache')
  call mkdirs(home || '/' || lang || '/lib')
  call mkdirs(home || '/' || lang || '/pkgs')
  call loadConfig
  emptyArgs = .string[]
  readToken = resolveToken(emptyArgs)     /* sent with every read, for private packages */
  call setClientHeader
  if a.0 < 1 then do
    call cmdHelp
    return 0
  end
  cmd = upper(a[1])
  rest = .string[]
  do i = 2 to a.0
    rest[i - 1] = a[i]
  end
  /* the update hint goes to stdout here (no stderr), so not before 'run' */
  if wordpos(cmd, 'INSTALL SEARCH SHOW') > 0 then call checkClientUpdate
  /* install scope: the current directory by default for the commands that
     manage installed packages; run/build use the shared store */
  if wordpos(cmd, 'INSTALL UNINSTALL LIST FREEZE SCAN') > 0 then rest = parseScope(rest)
  else call setScope('GLOBAL', '')
  select
    when cmd = 'UPDATE'    then return cmdUpdate(rest)
    when cmd = 'ADMIN'     then return cmdAdmin(rest)
    when cmd = 'INSTALL'   then call cmdInstall(rest)
    when cmd = 'UNINSTALL' then call cmdUninstall(rest)
    when cmd = 'LIST'      then call cmdList
    when cmd = 'SEARCH'    then call cmdSearch(rest)
    when cmd = 'SHOW'      then call cmdShow(rest)
    when cmd = 'FREEZE'    then call cmdFreeze
    when cmd = 'FIND'      then call cmdFind(rest)
    when cmd = 'SCAN'      then call cmdScan(rest)
    when cmd = 'RUN'       then return cmdRun(rest)
    when cmd = 'BUILD'     then return cmdBuild(rest)
    when cmd = 'PLATFORM'  then call cmdPlatform
    when cmd = 'CHECK'     then return cmdCheck()
    when cmd = 'PUBLISH'   then return cmdPublish(rest)
    when cmd = 'CONFIG'    then call cmdConfig(rest)
    when cmd = 'REGISTER'  then return cmdRegister(rest)
    when cmd = 'LOGIN'     then return cmdLogin(rest)
    when cmd = 'LOGOUT'    then call cmdLogout
    when cmd = 'WHOAMI'    then return cmdWhoami()
    when cmd = 'TOKEN'     then return cmdToken(rest)
    when cmd = 'OWNER'     then return cmdOwner(rest)
    when cmd = 'VISIBILITY' then return cmdVisibility(rest)
    when cmd = 'READER'    then return cmdReader(rest)
    when cmd = 'HELP'      then call cmdHelp
    otherwise do
      say "rxpip: unknown command '" || cmd || "' -- try 'rxpip help'"
      return 1
    end
  end
  if instFail = 1 then return 1
  return 0

cmdHelp: procedure = .void
  say 'RXPIP -- the REXX package manager (cREXX client)'
  say ''
  say 'Commands:'
  say '  install [--upgrade] <name>[==version]   install a package (and its deps) into the current'
  say '                              directory; --upgrade/-U updates an installed one'
  say '  uninstall <name>            remove an installed package'
  say '  list                        list installed packages'
  say '  find [dir...] [--sync]      find installs under dirs (default .), show duplicates/older copies;'
  say '                              --sync brings older copies up to the newest version found'
  say '  search <term>               search the repository'
  say '  show <name>                 show repository details for a package'
  say '  freeze                      print installed packages as name==version'
  say '  scan <file.crexx>           install packages named in REQUIRE comments'
  say '  run <file.crexx> [args]     scan + auto-install, compile with the packages, run'
  say '  build <file.crexx> [--output=name]   compile with the packages into .rxbin files; native plugins,'
  say '                              libraries and data are copied along, with a run script'
  say '  platform                    print this system platform tag (for publishing NATIVE artifacts)'
  say '  check                       re-check the system prerequisites of the installed packages'
  say '  publish <pkgfile> --name=N --version=V [...]   upload a package (needs login)'
  say '  register --user=U --invite=CODE   create an account (invite-only); saves your token'
  say '  login [--token=T]           save a token (or read it from env RXPIP_TOKEN)'
  say '  logout | whoami             forget / show the saved login'
  say '  token new [--label=L] | list | revoke <id>   manage your API tokens'
  say '  owner list|add|remove <pkg> [user]   manage who may publish a package'
  say '  visibility <pkg> [public|private]   show / set whether a package is public (owners)'
  say '  reader list|add|remove <pkg> [user]   who may read a private package besides its owners'
  say '  update [--check]            check for a newer rxpip and install it (this client: ' || clientVersion() || ')'
  say '  admin stats [--days=N] | users | lock <user> | client-publish <kind> --version=V <files>'
  say '                              administrator commands (need an administrator token)'
  say '  config get|set <key> [val]  view/change REPO_URL, LIB_DIR, INTERPRETER'
  say '  help                        this message'
  say ''
  say 'Scope options (install, uninstall, list, freeze, scan):'
  say '  --global, -g               use the shared store instead of the current directory'
  say '  --target=DIR, -t DIR       use directory DIR'
  say '  --force                    overwrite files that rxpip did not install'
  say '  --no-native                (install) skip native builds, install the source only'
  say '  --skip-runtime-check       (install) do not check system prerequisites (env RXPIP_SKIP_RUNTIME_CHECK=1 for run/build)'
  return

/* =====================================================================
   COMMANDS
   ===================================================================== */
cmdInstall: procedure = .void
  arg a = .string[]
  spec = ''
  do j = 1 to a.0
    if a[j] = '--upgrade' | a[j] = '-U' then upgrade = 1
    else if spec = '' then spec = a[j]
  end
  if spec = '' then do
    say 'usage: rxpip install [--upgrade] <name>[==version]'
    exit 1
  end
  seen = installOne(spec, '')
  return

installOne: procedure = .string
  arg spec = .string, seen = .string
  minver = ''
  wantver = ''
  name = ''
  if pos('>=', spec) > 0 then do
    p = pos('>=', spec)
    name = substr(spec, 1, p - 1)
    minver = strip(substr(spec, p + 2))
  end
  else if pos('==', spec) > 0 then do
    p = pos('==', spec)
    name = substr(spec, 1, p - 1)
    wantver = strip(substr(spec, p + 2))
  end
  else name = spec
  name = strip(name)

  if wordpos(name, seen) > 0 then return seen
  seen = seen name

  /* --upgrade applies to the package named on the command line only */
  up = upgrade
  upgrade = 0
  curver = installedVersion(name)
  newer = 0
  if curver \= '' & up = 1 & wantver = '' & minver = '' then do
    info0 = serverGet('INFO', 'name=' || urlEnc(name))
    if stanzaField(info0, 'STATUS') = 'OK' then do
      if compareVersions(stanzaField(info0, 'VERSION'), curver) > 0 then newer = 1
    end
  end
  if curver \= '' & newer = 0 then do
    satisfied = 0
    if wantver = '' & minver = '' then satisfied = 1
    else if wantver \= '' then do
      if compareVersions(curver, wantver) >= 0 then satisfied = 1
    end
    else if compareVersions(curver, minver) >= 0 then satisfied = 1
    if satisfied then do
      say 'rxpip: ' || name curver 'already installed'
      rec = findRecord(name)
      reqs = translate(stanzaField(rec, 'REQUIRES'), ' ', ',')
      do i = 1 to words(reqs)
        seen = installOne(depSpec(word(reqs, i)), seen)
      end
      return seen
    end
  end

  info = serverGet('INFO', 'name=' || urlEnc(name) || withVer(wantver))
  if stanzaField(info, 'STATUS') \= 'OK' then do
    say "rxpip: cannot resolve '" || name || "':" infoMessage(info)
    return seen
  end
  ver = stanzaField(info, 'VERSION')
  if minver \= '' then do
    if compareVersions(ver, minver) < 0 then do
      say "rxpip: '" || name || "' needs version >=" || minver 'but the repository has only' ver
      return seen
    end
  end
  author = stanzaField(info, 'AUTHOR')
  summary = stanzaField(info, 'SUMMARY')
  requires = stanzaField(info, 'REQUIRES')

  artresp = serverGet('ARTIFACTS', 'name=' || urlEnc(name) || '&version=' || urlEnc(ver))
  recs = artifactRecords(artresp)
  base = pickBase(recs)
  nat = ''
  avail = nativeSummary(recs)
  if avail \= '' & noNative = 0 then do
    nat = pickNative(recs)
    if nat = '' then do
      say "rxpip: '" || name || "'" ver 'has native builds only for' avail
      say '       this system is' platformTag() 'with ABI' supportedAbis() || '; use --no-native to install the source only, or ask the publisher for a build'
      instFail = 1
      return seen
    end
  end
  if base = '' & nat = '' then do
    say "rxpip: no compatible artifact for '" || name || "'" ver '(need SOURCE/' || lang || ' or a NATIVE build for ' || platformTag() || ')'
    instFail = 1
    return seen
  end
  files = ''
  tree = ''
  rt = ''
  bt = ''
  if base \= '' then do
    files = recField(base, 3)
    tree = recField(base, 4)
    if tree = '' then tree = files
    rt = recField(base, 6)
    bt = recField(base, 7)
  end
  if nat \= '' then do
    nt = recField(nat, 4)
    do k = 1 to words(nt)
      if wordpos(word(nt, k), tree) > 0 then do
        say "rxpip: '" || name || "'" ver 'is inconsistent: the source and native builds both contain' word(nt, k)
        instFail = 1
        return seen
      end
    end
    rt = rt recField(nat, 6)
    bt = bt recField(nat, 7)
  end
  rt = dedupe(rt)
  bt = dedupe(bt)

  /* system prerequisites: refuse clearly, before downloading anything */
  if skipRt = 0 & rt \= '' then do
    miss = runtimeMissing(rt)
    if miss \= '' then do
      say "rxpip: cannot install '" || name || "'" ver '- missing system prerequisites:' miss
      say '       install them with your system package manager and run the command again'
      say '       (--skip-runtime-check installs anyway)'
      instFail = 1
      return seen
    end
  end

  say 'rxpip: installing' name ver || ' (' || artLabel(base, nat) || ') ...'
  oldfiles = ''
  if curver \= '' then do
    /* replacing an older version: drop its files so none linger */
    oldfiles = stanzaField(findRecord(name), 'FILES')
  end
  if forceOw = 0 then do
    do k = 1 to words(files)
      if fileExists(tgtDir || '/' || word(files, k)) then do
        if wordpos(word(files, k), oldfiles) = 0 then do
          say "rxpip: '" || tgtDir || '/' || word(files, k) || "' already exists and was not installed by rxpip; use --force to overwrite"
          return seen
        end
      end
    end
  end

  pkgdir = home || '/' || lang || '/pkgs/' || name || '/' || ver
  call rmtree(pkgdir)
  call mkdirs(pkgdir)
  do part = 1 to 2
    rec = base
    if part = 2 then rec = nat
    if rec \= '' then do
      kind = recField(rec, 1)
      platform = recField(rec, 2)
      cachefile = home || '/cache/' || name || '-' || ver || '-' || kind || '-' || platform || '.rxpkg'
      if serverDownload(name, ver, kind, platform, cachefile) \= 0 then do
        say 'rxpip: download failed for' name ver
        return seen
      end
      call unblock(cachefile)
      argv = .string[]
      argv[1] = 'tar'
      argv[2] = 'xzf'
      argv[3] = cachefile
      argv[4] = '-C'
      argv[5] = pkgdir
      tmp = exec(argv)
    end
  end
  do k = 1 to words(oldfiles)
    call rmfile(tgtDir || '/' || word(oldfiles, k))
  end
  call unblock(pkgdir)
  /* the shared lib/ gets the top-level files of the source build; plugins,
     libraries and data stay inside the package directory */
  do i = 1 to words(files)
    fn = word(files, i)
    call mkdirs(tgtDir)
    call copyFile(pkgdir || '/' || fn, tgtDir || '/' || fn)
  end
  extra = ''
  if nat \= '' then extra = extra || 'NATIVE: ' || recField(nat, 2) || ' ' || recField(nat, 5) || NL
  if rt \= '' then extra = extra || 'RUNTIME-REQUIRES: ' || rt || NL
  if bt \= '' then extra = extra || 'BUILD-REQUIRES: ' || bt || NL
  call recordInstalled(name, ver, author, summary, requires, files, extra)

  reqs = translate(requires, ' ', ',')
  do i = 1 to words(reqs)
    seen = installOne(depSpec(word(reqs, i)), seen)
  end
  return seen

depSpec: procedure = .string
  arg tok = .string
  p = pos('>=', tok)
  if p > 0 then do
    dv = substr(tok, p + 2)
    if dv \= '' then return tok
    return substr(tok, 1, p - 1)
  end
  return tok

cmdUninstall: procedure = .void
  arg a = .string[]
  if a.0 < 1 then do
    say 'usage: rxpip uninstall <name>'
    exit 1
  end
  name = strip(a[1])
  rec = findRecord(name)
  if rec = '' then do
    say "rxpip: '" || name || "' is not installed"
    exit 1
  end
  files = stanzaField(rec, 'FILES')
  do i = 1 to words(files)
    call rmfile(tgtDir || '/' || word(files, i))
  end
  if isGlobal = 1 then call rmtree(home || '/' || lang || '/pkgs/' || name)
  call removeRecord(name)
  say 'rxpip: removed' name
  return

cmdList: procedure = .void
  recs = records()
  if recs.0 = 0 then do
    say '(no packages installed)'
    return
  end
  say left('NAME', 20) left('VERSION', 12) 'SUMMARY'
  say copies('-', 60)
  do i = 1 to recs.0
    say left(stanzaField(recs[i], 'NAME'), 20) left(stanzaField(recs[i], 'VERSION'), 12) stanzaField(recs[i], 'SUMMARY')
  end
  return

cmdFreeze: procedure = .void
  recs = records()
  do i = 1 to recs.0
    say stanzaField(recs[i], 'NAME') || '==' || stanzaField(recs[i], 'VERSION')
  end
  return

/* =====================================================================
   INSTALL SCOPE and `find`
   ===================================================================== */
setScope: procedure = .void
  arg mode = .string, dir = .string
  if mode = 'GLOBAL' then do
    isGlobal = 1
    tgtDir = home || '/' || lang || '/lib'
    recDir = home || '/' || lang
  end
  else do
    if dir = '' then dir = getenv('PWD')
    if dir = '' then dir = '.'
    dir = translate(dir, '/', '5C'x)
    if length(dir) > 1 then do
      if right(dir, 1) = '/' then dir = substr(dir, 1, length(dir) - 1)
    end
    isGlobal = 0
    tgtDir = dir
    recDir = dir || '/.rxpip'
  end
  return

parseScope: procedure = .string[]
  arg a = .string[]
  mode = 'LOCAL'
  dir = ''
  res = .string[]
  n = 0
  i = 1
  do while i <= a.0
    w = a[i]
    if w = '--global' | w = '-g' then mode = 'GLOBAL'
    else if left(w, 9) = '--target=' then dir = substr(w, 10)
    else if w = '-t' | w = '--target' then do
      i = i + 1
      if i <= a.0 then dir = a[i]
    end
    else if w = '--force' then forceOw = 1
    else if w = '--no-native' then noNative = 1
    else if w = '--skip-runtime-check' then skipRt = 1
    else do
      n = n + 1
      res[n] = w
    end
    i = i + 1
  end
  if dir \= '' then mode = 'LOCAL'
  call setScope(mode, dir)
  return res

cmdFind: procedure = .void
  arg a = .string[]
  sync = 0
  roots = ''
  do i = 1 to a.0
    if a[i] = '--sync' then sync = 1
    else roots = roots || a[i] || SOH
  end
  if roots = '' then do
    pw = getenv('PWD')
    if pw = '' then pw = '.'
    roots = pw || SOH
  end
  /* locations: the shared store plus every .../.rxpip/installed.txt below the roots */
  locs = .string[]
  nl = 1
  locs[1] = home || '/' || lang
  do while roots \= ''
    p = pos(SOH, roots)
    r = substr(roots, 1, p - 1)
    roots = substr(roots, p + 1)
    argv = .string[]
    argv[1] = 'find'
    argv[2] = r
    argv[3] = '-name'
    argv[4] = 'installed.txt'
    argv[5] = '-path'
    argv[6] = '*/.rxpip/installed.txt'
    found = exec(argv)
    do while found \= ''
      ln = nextLine(found)
      q = pos('/.rxpip/installed.txt', ln)
      if q > 0 then do
        d = substr(ln, 1, q + 6)
        dup = 0
        do j = 1 to nl
          if locs[j] = d then dup = 1
        end
        if dup = 0 then do
          nl = nl + 1
          locs[nl] = d
        end
      end
    end
  end
  /* collect name / version / dir triples */
  names = .string[]
  vers = .string[]
  dirs = .string[]
  n = 0
  do i = 1 to nl
    recs = recordsAt(locs[i])
    do j = 1 to recs.0
      n = n + 1
      names[n] = stanzaField(recs[j], 'NAME')
      vers[n] = stanzaField(recs[j], 'VERSION')
      dirs[n] = locs[i]
    end
  end
  if n = 0 then do
    say '(no rxpip installs found)'
    return
  end
  best = .string[]
  do i = 1 to n
    best[i] = vers[i]
    do j = 1 to n
      if names[j] = names[i] then do
        if compareVersions(vers[j], best[i]) > 0 then best[i] = vers[j]
      end
    end
  end
  say left('NAME', 20) left('VERSION', 12) 'LOCATION'
  say copies('-', 70)
  fixIdx = .string[]
  nfix = 0
  ndup = 0
  dupSeen = ' '
  do i = 1 to n
    if dirs[i] = home || '/' || lang then shown = '(shared store) ' || dirs[i]
    else shown = substr(dirs[i], 1, length(dirs[i]) - 7)
    note = ''
    if compareVersions(vers[i], best[i]) < 0 then do
      note = '  <- older than' best[i]
      nfix = nfix + 1
      fixIdx[nfix] = i
    end
    say left(names[i], 20) left(vers[i], 12) shown || note
    c = 0
    do j = 1 to n
      if names[j] = names[i] then c = c + 1
    end
    if c > 1 then do
      if pos(' ' || names[i] || ' ', dupSeen) = 0 then do
        dupSeen = dupSeen || names[i] || ' '
        ndup = ndup + 1
      end
    end
  end
  say ''
  say n 'install(s),' ndup 'package(s) in more than one place,' nfix 'outdated.'
  if nfix > 0 then do
    if sync = 1 then do
      say ''
      do k = 1 to nfix
        ix = fixIdx[k]
        if dirs[ix] = home || '/' || lang then call setScope('GLOBAL', '')
        else call setScope('LOCAL', substr(dirs[ix], 1, length(dirs[ix]) - 7))
        upgrade = 1
        say 'rxpip: updating' names[ix] 'in' tgtDir
        seenx = installOne(names[ix] || '==' || best[ix], '')
      end
    end
    else say "Run 'rxpip find --sync' to bring the older copies up to date."
  end
  return

cmdSearch: procedure = .void
  arg a = .string[]
  term = ''
  do i = 1 to a.0
    term = term a[i]
  end
  term = strip(term)
  call printStanzas(serverGet('SEARCH', 'q=' || urlEnc(term)))
  return

cmdShow: procedure = .void
  arg a = .string[]
  if a.0 < 1 then do
    say 'usage: rxpip show <name>'
    exit 1
  end
  resp = serverGet('INFO', 'name=' || urlEnc(a[1]))
  if stanzaField(resp, 'STATUS') \= 'OK' then do
    say 'rxpip:' infoMessage(resp)
    exit 1
  end
  call printStanzas(resp)
  return

cmdScan: procedure = .void
  arg a = .string[]
  if a.0 < 1 then do
    say "rxpip: file not found: ''"
    exit 1
  end
  if \fileExists(a[1]) then do
    say "rxpip: file not found: '" || a[1] || "'"
    exit 1
  end
  reqs = scanRequires(a[1])
  if reqs = '' then do
    say 'rxpip: no REQUIRE directives found in' a[1]
    return
  end
  seen = ''
  do i = 1 to words(reqs)
    seen = installOne(word(reqs, i), seen)
  end
  return

/* REQUIRE directives: a comment ln  /* REQUIRE name[>=ver] */  or  -- REQUIRE name[>=ver] */
scanRequires: procedure = .string
  arg fn = .string
  out = ''
  txt = loadtext(fn, NL)
  do while txt \= ''
    ln = ''
    p = pos(NL, txt)
    if p = 0 then do
      ln = txt
      txt = ''
    end
    else do
      ln = substr(txt, 1, p - 1)
      txt = substr(txt, p + 1)
    end
    l = strip(ln)
    body = ''
    if left(l, 2) = '/*' then do
      body = substr(l, 3)
      q = pos('*/', body)
      if q > 0 then body = left(body, q - 1)
    end
    else if left(l, 2) = '--' then body = substr(l, 3)
    else iterate
    body = strip(body)
    if upper(left(body, 7)) \= 'REQUIRE' then iterate
    spec = strip(substr(body, 8))
    if spec = '' then iterate
    out = out spec
  end
  return strip(out)

/* locate rxc / rxas / rxvm: CREXX_HOME/bin first, then the PATH */
tool: procedure = .string
  arg nm = .string
  ch = getenv('CREXX_HOME')
  if ch \= '' then do
    if fileExists(ch || '/bin/' || nm) then return ch || '/bin/' || nm
  end
  return nm

/* compile the user's program + installed modules; returns the list of rxbin
   base names (user's program first), '' on failure */
compileAll: procedure = .string
  arg src = .string, outdir = .string
  call mkdirs(outdir)
  libdir = home || '/' || lang || '/lib'
  mods = ''
  names = listDir(libdir)
  do i = 1 to names.0
    n = names[i]
    if right(n, 6) = '.crexx' then do
      base = left(n, length(n) - 6)
      call copyFile(libdir || '/' || n, outdir || '/' || n)
      mods = mods base
    end
  end
  cls = baseName(src)
  cls = left(cls, length(cls) - 6)
  call copyFile(src, outdir || '/' || baseName(src))
  all = cls mods
  do i = 1 to words(all)
    m = word(all, i)
    argv = .string[]
    argv[1] = tool('rxc')
    argv[2] = '-s'
    argv[3] = outdir
    argv[4] = '-o'
    argv[5] = outdir || '/' || m
    argv[6] = outdir || '/' || m || '.crexx'
    msg = exec(argv)
    if lastrc \= 0 then do
      say msg
      return ''
    end
    argv2 = .string[]
    argv2[1] = tool('rxas')
    argv2[2] = outdir || '/' || m
    msg = exec(argv2)
    if lastrc \= 0 then do
      say msg
      return ''
    end
  end
  return all

cmdRun: procedure = .int
  arg a = .string[]
  if a.0 < 1 then do
    say "rxpip: file not found: ''"
    return 1
  end
  if \fileExists(a[1]) then do
    say "rxpip: file not found: '" || a[1] || "'"
    return 1
  end
  src = a[1]
  seen = ''
  reqs = scanRequires(src)
  do i = 1 to words(reqs)
    seen = installOne(word(reqs, i), seen)
  end
  bad = verifyInstalled(seen, 0)
  if bad \= '' then do
    call charout , bad
    say '       install the missing prerequisites and try again (env RXPIP_SKIP_RUNTIME_CHECK=1 skips the check)'
    return 1
  end
  tmp = home || '/run_' || pid()
  all = compileAll(src, tmp)
  if all = '' then do
    say 'rxpip: compilation failed'
    call rmtree(tmp)
    return 1
  end
  /* native plugins, libraries and data of the packages in use */
  provs = collectDirs(seen, 'providers', ';')
  libs = collectDirs(seen, 'libs', pathSep())
  envs = .string[]
  ne = 0
  if libs \= '' then do
    curl = getenv(libVar())
    if curl \= '' then libs = libs || pathSep() || curl
    ne = ne + 1
    envs[ne] = libVar() || '=' || libs
  end
  do i = 1 to words(seen)
    d = pkgDirOf(word(seen, i))
    if d \= '' then do
      ne = ne + 1
      envs[ne] = envName(word(seen, i)) || '=' || d
    end
  end
  argv = .string[]
  n = 1
  argv[1] = tool('rxvm')
  if provs \= '' then do
    n = n + 1
    argv[n] = '--provider-path'
    n = n + 1
    argv[n] = provs
  end
  do i = 1 to words(all)
    n = n + 1
    argv[n] = tmp || '/' || word(all, i)
  end
  if a.0 > 1 then do
    n = n + 1
    argv[n] = '-a'
    do i = 2 to a.0
      n = n + 1
      argv[n] = a[i]
    end
  end
  out = execEnv(argv, envs)
  if out \= '' then call charout , out
  rcv = lastrc
  call rmtree(tmp)
  return rcv

cmdBuild: procedure = .int
  arg a = .string[]
  if a.0 < 1 then do
    say 'usage: rxpip build <file.crexx> [--output=name]'
    return 1
  end
  if \fileExists(a[1]) then do
    say 'usage: rxpip build <file.crexx> [--output=name]'
    return 1
  end
  src = a[1]
  cls = baseName(src)
  cls = left(cls, length(cls) - 6)
  out = opt(a, 'output')
  if out = '' then out = 'build_' || cls
  seen = ''
  reqs = scanRequires(src)
  do i = 1 to words(reqs)
    seen = installOne(word(reqs, i), seen)
  end
  bad = verifyInstalled(seen, 1)
  if bad \= '' then do
    call charout , bad
    say '       install the missing prerequisites and try again (env RXPIP_SKIP_RUNTIME_CHECK=1 skips the check)'
    return 1
  end
  call mkdirs(out)
  all = compileAll(src, out)
  if all = '' then do
    say 'rxpip: compilation failed'
    return 1
  end
  copied = exportNative(seen, out, cls, all)
  say 'rxpip: wrote' out '(run: rxvm' || ' ' || out || '/' || cls || ' ' || out || '/<module>... )'
  return 0

/* copy the packages that carry plugins, libraries or data into <out>/pkgs
   and write run.sh / run.bat that start the program with them; prints the
   system prerequisites rxpip cannot ship. Returns the packages copied. */
exportNative: procedure = .string
  arg names = .string, out = .string, cls = .string, all = .string
  copied = ''
  reqs = ''
  do i = 1 to words(names)
    nm = word(names, i)
    d = pkgDirOf(nm)
    if d \= '' then do
      rt = stanzaField(findRecord(nm), 'RUNTIME-REQUIRES')
      if rt \= '' then reqs = reqs rt
      if fileExists(d || '/providers') | fileExists(d || '/libs') | fileExists(d || '/share') then do
        dst = out || '/pkgs/' || nm
        call mkdirs(dst)
        argv = .string[]
        argv[1] = 'cp'
        argv[2] = '-R'
        argv[3] = d || '/.'
        argv[4] = dst
        x = exec(argv)
        copied = copied nm
      end
    end
  end
  copied = strip(copied)
  if copied \= '' then do
    provs = ''
    libs = ''
    envsh = ''
    bprov = ''
    blib = ''
    benv = ''
    do i = 1 to words(copied)
      nm = word(copied, i)
      dst = out || '/pkgs/' || nm
      if fileExists(dst || '/providers') then do
        if provs \= '' then provs = provs || ';'
        provs = provs || '$d/pkgs/' || nm || '/providers'
        if bprov \= '' then bprov = bprov || ';'
        bprov = bprov || '%D%pkgs\' || nm || '\providers'
      end
      if fileExists(dst || '/libs') then do
        if libs \= '' then libs = libs || pathSep()
        libs = libs || '$d/pkgs/' || nm || '/libs'
        blib = blib || '%D%pkgs\' || nm || '\libs;'
      end
      envsh = envsh || 'export ' || envName(nm) || '="$d/pkgs/' || nm || '"' || NL
      benv = benv || 'set "' || envName(nm) || '=%D%pkgs\' || nm || '"' || NL
    end
    mods = ''
    bmods = ''
    do i = 1 to words(all)
      mods = mods || ' "$d/' || word(all, i) || '"'
      bmods = bmods || ' "%D%' || word(all, i) || '"'
    end
    vm = 'rxvm'
    sh = '#!/bin/sh' || NL || 'd=$(cd "$(dirname "$0")" && pwd)' || NL
    sh = sh || 'RXVM=rxvm' || NL
    sh = sh || '[ -n "$CREXX_HOME" ] && [ -x "$CREXX_HOME/bin/rxvm" ] && RXVM="$CREXX_HOME/bin/rxvm"' || NL
    if libs \= '' then do
      lv = libVar()
      sh = sh || 'export ' || lv || '="' || libs || '${' || lv || ':+' || pathSep() || '$' || lv || '}"' || NL
    end
    sh = sh || envsh
    po = ''
    if provs \= '' then po = ' --provider-path "' || provs || '"'
    sh = sh || 'if [ $# -gt 0 ]; then exec "$RXVM"' || po || mods || ' -a "$@"; fi' || NL
    sh = sh || 'exec "$RXVM"' || po || mods || NL
    call writeText(out || '/run.sh', sh)
    cm = .string[]
    cm[1] = 'chmod'
    cm[2] = '755'
    cm[3] = out || '/run.sh'
    x = exec(cm)
    bt = '@echo off' || NL || 'set "D=%~dp0"' || NL
    if blib \= '' then bt = bt || 'set "PATH=' || blib || '%PATH%"' || NL
    bt = bt || benv
    bpo = ''
    if bprov \= '' then bpo = ' --provider-path "' || bprov || '"'
    bt = bt || 'if "%~1"=="" (rxvm' || bpo || bmods || ') else (rxvm' || bpo || bmods || ' -a %*)' || NL
    call writeText(out || '/run.bat', bt)
    say 'rxpip: native plugins/libraries/data for' copied 'copied to' out || '/pkgs; start the program with' out || '/run.sh'
  end
  reqs = dedupe(reqs)
  if reqs \= '' then say 'rxpip: external prerequisites rxpip does not ship (install on the target system):' reqs
  return copied

/* ---- accounts, tokens, owners ---- */
cmdPublish: procedure = .int
  arg a = .string[]
  if a.0 < 1 then do
    say 'usage: rxpip publish <file.rxpkg> --name=X --version=Y [--token=T] [--author=A --summary=S --requires=R --kind=SOURCE|BYTECODE|NATIVE --platform=TAG --abi=TAG --runtime-requires=L --build-requires=L --private|--public]'
    return 1
  end
  if \fileExists(a[1]) then do
    say 'usage: rxpip publish <file.rxpkg> --name=X --version=Y [--token=T] [--author=A --summary=S --requires=R --kind=SOURCE|BYTECODE|NATIVE --platform=TAG --abi=TAG --runtime-requires=L --build-requires=L --private|--public]'
    return 1
  end
  pkgfile = a[1]
  name = opt(a, 'name')
  ver = opt(a, 'version')
  kind = opt(a, 'kind')
  if kind = '' then kind = 'SOURCE'
  platform = opt(a, 'platform')
  if platform = '' then do
    platform = lang
    if upper(kind) = 'NATIVE' then platform = platformTag()
  end
  token = resolveToken(a)
  if name = '' | ver = '' | token = '' then do
    say 'rxpip: --name, --version and a login are required (rxpip login, or --token=T, or env RXPIP_TOKEN)'
    return 1
  end
  if \tokenLooksValid(token) then do
    say 'rxpip: token must be 16-128 characters from A-Z a-z 0-9 . _ ~ -'
    return 1
  end
  hdrs = .string[]
  hdrs[1] = 'X-Rxpip-Name: ' || name
  hdrs[2] = 'X-Rxpip-Version: ' || ver
  hdrs[3] = 'X-Rxpip-Author: ' || opt(a, 'author')
  hdrs[4] = 'X-Rxpip-Summary: ' || opt(a, 'summary')
  hdrs[5] = 'X-Rxpip-Requires: ' || opt(a, 'requires')
  hdrs[6] = 'X-Rxpip-Kind: ' || kind
  hdrs[7] = 'X-Rxpip-Platform: ' || platform
  nh = 7
  if opt(a, 'abi') \= '' then do
    nh = nh + 1
    hdrs[nh] = 'X-Rxpip-Abi: ' || opt(a, 'abi')
  end
  if opt(a, 'runtime-requires') \= '' then do
    nh = nh + 1
    hdrs[nh] = 'X-Rxpip-Runtime-Requires: ' || opt(a, 'runtime-requires')
  end
  if opt(a, 'build-requires') \= '' then do
    nh = nh + 1
    hdrs[nh] = 'X-Rxpip-Build-Requires: ' || opt(a, 'build-requires')
  end
  do j = 1 to a.0
    if a[j] = '--private' then do
      nh = nh + 1
      hdrs[nh] = 'X-Rxpip-Visibility: private'
    end
    if a[j] = '--public' then do
      nh = nh + 1
      hdrs[nh] = 'X-Rxpip-Visibility: public'
    end
  end
  sec = .string[]
  sec[1] = 'X-Rxpip-Token: ' || token
  return showResponse(serverPost('PUBLISH', '', hdrs, sec, pkgfile))

cmdRegister: procedure = .int
  arg a = .string[]
  user = opt(a, 'user')
  inv = opt(a, 'invite')
  if inv = '' then inv = getenv('RXPIP_INVITE')
  if user = '' | inv = '' then do
    say 'usage: rxpip register --user=<name> --invite=<code>   (invite from the repository admin)'
    return 1
  end
  hdrs = .string[]
  hdrs[1] = 'X-Rxpip-User: ' || user
  sec = .string[]
  sec[1] = 'X-Rxpip-Invite: ' || inv
  out = serverPost('REGISTER', '', hdrs, sec, '')
  if stanzaField(out, 'STATUS') \= 'OK' then do
    call showResponse(out)
    return 1
  end
  call saveCredential(user, stanzaField(out, 'TOKEN'))
  say 'registered as ' || user || '; your token was saved in ' || home || '/credentials.txt'
  say 'Treat that file like a password. You can now: rxpip publish ...'
  return 0

cmdLogin: procedure = .int
  arg a = .string[]
  t = opt(a, 'token')
  if t = '' then t = getenv('RXPIP_TOKEN')
  if t = '' then do
    say 'usage: rxpip login --token=<token>   (or set env RXPIP_TOKEN)'
    return 1
  end
  if \tokenLooksValid(t) then do
    say 'usage: rxpip login --token=<token>   (or set env RXPIP_TOKEN)'
    return 1
  end
  sec = .string[]
  sec[1] = 'X-Rxpip-Token: ' || t
  noh = .string[]
  out = serverPost('WHOAMI', '', noh, sec, '')
  if stanzaField(out, 'STATUS') \= 'OK' then do
    call showResponse(out)
    return 1
  end
  u = stanzaField(out, 'USER')
  call saveCredential(u, t)
  say 'logged in as' u
  return 0

cmdLogout: procedure = .void
  call removeCredential
  say 'logged out of' repoUrl
  return

authCall: procedure = .string
  arg action = .string, hdrs = .string[]
  empty = .string[]
  t = resolveToken(empty)
  if t = '' then do
    say 'not logged in (rxpip login --token=T)'
    exit 1
  end
  sec = .string[]
  sec[1] = 'X-Rxpip-Token: ' || t
  return serverPost(action, '', hdrs, sec, '')

cmdWhoami: procedure = .int
  empty = .string[]
  t = resolveToken(empty)
  if t = '' then do
    say 'not logged in'
    return 1
  end
  noh = .string[]
  return showResponse(authCall('WHOAMI', noh))

cmdToken: procedure = .int
  arg a = .string[]
  sub = ''
  if a.0 > 0 then sub = upper(a[1])
  hdrs = .string[]
  select
    when sub = 'NEW' then do
      lbl = opt(a, 'label')
      if lbl \= '' then hdrs[1] = 'X-Rxpip-Label: ' || lbl
      return showResponse(authCall('NEWTOKEN', hdrs))
    end
    when sub = 'LIST' then return showResponse(authCall('TOKENS', hdrs))
    when sub = 'REVOKE' then do
      if a.0 < 2 then do
        say 'usage: rxpip token revoke <token-id>   (see: rxpip token list)'
        return 1
      end
      hdrs[1] = 'X-Rxpip-Token-Id: ' || a[2]
      return showResponse(authCall('REVOKE', hdrs))
    end
    otherwise do
      say 'usage: rxpip token new [--label=L] | list | revoke <id>'
      return 1
    end
  end
  return 1

cmdOwner: procedure = .int
  arg a = .string[]
  sub = ''
  pkg = ''
  who = ''
  if a.0 > 0 then sub = upper(a[1])
  if a.0 > 1 then pkg = a[2]
  if a.0 > 2 then who = a[3]
  bad = 0
  if pkg = '' then bad = 1
  if sub \= 'LIST' & sub \= 'ADD' & sub \= 'REMOVE' then bad = 1
  if sub \= 'LIST' & who = '' then bad = 1
  if bad then do
    say 'usage: rxpip owner list <pkg> | add <pkg> <user> | remove <pkg> <user>'
    return 1
  end
  if sub = 'LIST' then return showResponse(serverGet('OWNERS', 'name=' || urlEnc(pkg)))
  hdrs = .string[]
  hdrs[1] = 'X-Rxpip-Name: ' || pkg
  hdrs[2] = 'X-Rxpip-User: ' || who
  return showResponse(authCall(sub || 'OWNER', hdrs))

cmdVisibility: procedure = .int
  arg a = .string[]
  pkg = ''
  val = ''
  if a.0 > 0 then pkg = a[1]
  if a.0 > 1 then val = lower(a[2])
  bad = 0
  if pkg = '' then bad = 1
  if val \= '' & val \= 'public' & val \= 'private' then bad = 1
  if bad then do
    say 'usage: rxpip visibility <pkg> [public|private]'
    return 1
  end
  hdrs = .string[]
  hdrs[1] = 'X-Rxpip-Name: ' || pkg
  if val = '' then return showResponse(authCall('READERS', hdrs))
  hdrs[2] = 'X-Rxpip-Value: ' || val
  return showResponse(authCall('VISIBILITY', hdrs))

cmdReader: procedure = .int
  arg a = .string[]
  sub = ''
  pkg = ''
  who = ''
  if a.0 > 0 then sub = upper(a[1])
  if a.0 > 1 then pkg = a[2]
  if a.0 > 2 then who = a[3]
  bad = 0
  if pkg = '' then bad = 1
  if sub \= 'LIST' & sub \= 'ADD' & sub \= 'REMOVE' then bad = 1
  if sub \= 'LIST' & who = '' then bad = 1
  if bad then do
    say 'usage: rxpip reader list <pkg> | add <pkg> <user> | remove <pkg> <user>'
    return 1
  end
  act = 'READERS'
  if sub = 'ADD' then act = 'ADDREADER'
  if sub = 'REMOVE' then act = 'REMOVEREADER'
  hdrs = .string[]
  hdrs[1] = 'X-Rxpip-Name: ' || pkg
  hdrs[2] = 'X-Rxpip-User: ' || who
  return showResponse(authCall(act, hdrs))

cmdConfig: procedure = .void
  arg a = .string[]
  sub = ''
  if a.0 > 0 then sub = upper(a[1])
  if sub = 'GET' & a.0 > 1 then do
    say a[2] || ':' getConfig(a[2])
  end
  else if sub = 'SET' & a.0 > 2 then do
    call setConfig(a[2], a[3])
    say 'rxpip: set' a[2] '=' a[3]
  end
  else do
    say 'REPO_URL:' getConfig('REPO_URL')
    say 'LIB_DIR:' getConfig('LIB_DIR')
    say 'INTERPRETER:' getConfig('INTERPRETER')
  end
  return

/* =====================================================================
   CONFIG AND CREDENTIALS
   ===================================================================== */
loadConfig: procedure = .void
  cf = home || '/config.txt'
  if \fileExists(cf) then do
    call writeText(cf, 'REPO_URL: https://www.rexxpository.org/cgi-bin/rxpip_server.rexx' || NL || 'LIB_DIR: ' || home || '/lib' || NL || 'INTERPRETER: regina' || NL)
  end
  repoUrl = getConfig('REPO_URL')
  return

getConfig: procedure = .string
  arg key = .string
  cf = home || '/config.txt'
  val = ''
  if fileExists(cf) then do
    lines = readlines(cf)
    do i = 1 to lines.0
      p = pos(':', lines[i])
      if p > 0 then do
        if upper(strip(substr(lines[i], 1, p - 1))) = upper(key) then val = strip(substr(lines[i], p + 1))
      end
    end
  end
  return val

setConfig: procedure = .void
  arg key = .string, val = .string
  cf = home || '/config.txt'
  key = upper(key)
  out = ''
  done = 0
  if fileExists(cf) then do
    lines = readlines(cf)
    do i = 1 to lines.0
      if strip(lines[i]) = '' then iterate
      p = pos(':', lines[i])
      k = ''
      if p > 0 then k = upper(strip(substr(lines[i], 1, p - 1)))
      if k = key then do
        out = out || key || ': ' || val || NL
        done = 1
      end
      else out = out || lines[i] || NL
    end
  end
  if \done then out = out || key || ': ' || val || NL
  call writeText(cf, out)
  repoUrl = getConfig('REPO_URL')
  return

/* credentials.txt: one ln per repository:  <repo_url> <user> <token>  */
getCredential: procedure = .string
  f = home || '/credentials.txt'
  res = ''
  if fileExists(f) then do
    lines = readlines(f)
    do i = 1 to lines.0
      if word(lines[i], 1) = repoUrl then res = word(lines[i], 2) || SOH || word(lines[i], 3)
    end
  end
  return res

credentialLines: procedure = .string
  f = home || '/credentials.txt'
  keep = ''
  if fileExists(f) then do
    lines = readlines(f)
    do i = 1 to lines.0
      if strip(lines[i]) \= '' & word(lines[i], 1) \= repoUrl then keep = keep || lines[i] || NL
    end
  end
  return keep

saveCredential: procedure = .void
  arg user = .string, token = .string
  call writePrivate(home || '/credentials.txt', credentialLines() || repoUrl user token || NL)
  return

removeCredential: procedure = .void
  keep = credentialLines()
  f = home || '/credentials.txt'
  if keep = '' then call rmfile(f)
  else call writePrivate(f, keep)
  return

resolveToken: procedure = .string
  arg a = .string[]
  t = opt(a, 'token')
  if t = '' then t = getenv('RXPIP_TOKEN')
  if t = '' then do
    c = getCredential()
    p = pos(SOH, c)
    if p > 0 then t = substr(c, p + 1)
  end
  return t

tokenLooksValid: procedure = .int
  arg t = .string
  if length(t) < 16 | length(t) > 128 then return 0
  if verify(t, 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._~-') = 0 then return 1
  return 0

/* =====================================================================
   CLIENT VERSION, SELF-UPDATE and ADMINISTRATION
   Every request carries X-Rxpip-Client: crexx/<version> (<os>) -- all the
   server learns about this machine. `rxpip update` replaces rxpip.crexx;
   the launcher recompiles it on the next start.
   ===================================================================== */
clientVersion: procedure = .string
  return '1.4.0'

setClientHeader: procedure = .void
  os = 'unknown'
  out = .string[]
  address crexx "platform" output out
  if out.0 > 0 then do
    l = out[1]
    if left(l, 3) = 'os=' then os = translate(substr(l, 4), 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ')
  end
  clientHdr = 'X-Rxpip-Client: crexx/' || clientVersion() || ' (' || os || ')'
  return

clientDir: procedure = .string
  d = getenv('RXPIP_CLIENT_DIR')
  if d = '' then d = '.'
  return translate(d, '/', '5C'x)

updateChannelOk: procedure = .int
  if left(repoUrl, 8) = 'https://' then return 1
  if left(repoUrl, 17) = 'http://127.0.0.1:' | left(repoUrl, 17) = 'http://localhost:' then return 1
  return 0

cmdUpdate: procedure = .int
  arg a = .string[]
  chk = 0
  do i = 1 to a.0
    if a[i] = '--check' then chk = 1
  end
  return doUpdate(chk, 0)

doUpdate: procedure = .int
  arg checkonly = .int, quiet = .int
  kind = 'crexx'
  cur = clientVersion()
  m = serverGet('CLIENT', 'kind=' || kind)
  if stanzaField(m, 'STATUS') \= 'OK' then do
    if quiet = 0 then say 'rxpip: no client release is published for ' || kind
    return 1
  end
  latest = stanzaField(m, 'VERSION')
  flist = stanzaField(m, 'FILES')
  if compareVersions(latest, cur) <= 0 then do
    if quiet = 0 then say 'rxpip ' || cur || ' (' || kind || ') is up to date'
    return 0
  end
  if checkonly = 1 then do
    say 'rxpip ' || latest || ' is available (you have ' || cur || '). Run: rxpip update'
    return 0
  end
  if updateChannelOk() = 0 then do
    say 'rxpip: refusing to update over an unencrypted connection (' || repoUrl || ')'
    return 1
  end
  dir = clientDir()
  say 'rxpip: updating ' || cur || ' -> ' || latest || ' in ' || dir
  do i = 1 to words(flist)
    f = word(flist, i)
    nf = dir || '/' || f || '.new'
    call rmfile(nf)
    argv = .string[]
    argv[1] = 'curl'
    argv[2] = '-s'
    argv[3] = '-f'
    argv[4] = '-H'
    argv[5] = clientHdr
    argv[6] = '-o'
    argv[7] = nf
    argv[8] = repoUrl || '?action=CLIENT&kind=' || kind || '&version=' || latest || '&file=' || urlEnc(f)
    x = exec(argv)
    good = 0
    if fileExists(nf) = 1 then good = 1
    if good = 0 then do
      say 'rxpip: could not download or write ' || f || ' in ' || dir || ' (permissions? try again as the owner of that directory)'
      do j = 1 to i
        call rmfile(dir || '/' || word(flist, j) || '.new')
      end
      return 1
    end
  end
  do i = 1 to words(flist)
    call unblock(dir || '/' || word(flist, i) || '.new')
  end
  vr = verifyRelease(dir, flist)
  vstat = word(vr, 1)
  vfile = word(vr, 2)
  if vstat = 'FAIL' then say 'rxpip: the signature of ' || vfile || ' is NOT valid -- the update is refused'
  else if vstat \= 'OK' & getConfig('REQUIRE_SIGNATURE') = '1' then do
    if vstat = 'NOTOOL' then say 'rxpip: REQUIRE_SIGNATURE is set but minisign is not installed -- the update is refused'
    else say 'rxpip: REQUIRE_SIGNATURE is set but this release is not (fully) signed -- the update is refused'
    vstat = 'FAIL'
  end
  if vstat = 'FAIL' then do
    do j = 1 to words(flist)
      call rmfile(dir || '/' || word(flist, j) || '.new')
    end
    return 1
  end
  if vstat = 'NOTOOL' then say 'rxpip: note: signatures not checked (install minisign to check them)'
  if vstat = 'UNSIGNED' then say 'rxpip: note: this release is not signed'
  if vstat = 'OK' then say 'rxpip: signature verified'
  ao = .string[]
  ae = .string[]
  do i = 1 to words(flist)
    f = word(flist, i)
    nf = dir || '/' || f || '.new'
    tf = dir || '/' || f
    address crexx "mv :nf :tf" output ao error ae
    do                                               /* launchers stay executable */
      cmv = .string[]
      cmv[1] = 'chmod'
      cmv[2] = '755'
      cmv[3] = tf
      x = exec(cmv)
    end
  end
  call rmfile(home || '/crexx/bin/rxpip.rxbin')   /* the launcher recompiles the new source */
  call stampCheck(latest, '')
  say 'rxpip: updated to ' || latest
  return 0

readAll: procedure = .string
  arg f = .string
  res = ''
  rl = readlines(f)
  do i = 1 to rl.0
    res = res || rl[i] || NL
  end
  return res

/* Remove the "downloaded from the Internet" mark (Windows Zone.Identifier,
   macOS quarantine) from a file or tree that rxpip itself downloaded or
   unpacked, so binaries, DLLs and .so files in a package work. Never an error. */
unblock: procedure = .void
  arg path = .string
  uv = .string[]
  if getenv('OS') = 'Windows_NT' then do
    wp = translate(path, '5C'x, '/')
    uv[1] = 'cmd'
    uv[2] = '/c'
    uv[3] = 'dir /s /r "' || wp || '" 2>nul | find ":Zone.Identifier" >nul'
    x = exec(uv)
    if lastrc = 0 then do
      pv = .string[]
      pv[1] = 'powershell'
      pv[2] = '-NoProfile'
      pv[3] = '-NonInteractive'
      pv[4] = '-Command'
      pv[5] = "Get-ChildItem -LiteralPath '" || wp || "' -Recurse -Force | Unblock-File"
      x = exec(pv)
    end
  end
  else do
    uv[1] = 'sh'
    uv[2] = '-c'
    uv[3] = '[ "$(uname -s)" = Darwin ] && xattr -dr com.apple.quarantine "$1" >/dev/null 2>&1; true'
    uv[4] = 'sh'
    uv[5] = path
    x = exec(uv)
  end
  return

/* the minisign public key that signs the releases */
signKey: procedure = .string
  k = getenv('RXPIP_MINISIGN_KEY')
  if k = '' then k = 'RWTwuk9ZuGM56RANzR4KRqK6p6VEGsdcFyB6+vTeRmrlWFWZouyOjcYY'
  return k

/* check the downloaded (.new) files against their .minisig: OK, UNSIGNED,
   NOTOOL (minisign missing) or "FAIL <file>" */
verifyRelease: procedure = .string
  arg dir = .string, flist = .string
  signed = 0
  unsigned = 0
  do i = 1 to words(flist)
    f = word(flist, i)
    if right(f, 8) = '.minisig' then iterate
    if wordpos(f || '.minisig', flist) > 0 then signed = signed + 1
    else unsigned = unsigned + 1
  end
  if signed = 0 then return 'UNSIGNED'
  tv = .string[]
  tv[1] = 'minisign'
  tv[2] = '-v'
  x = exec(tv)
  if lastrc \= 0 then return 'NOTOOL'
  do i = 1 to words(flist)
    f = word(flist, i)
    if right(f, 8) = '.minisig' | wordpos(f || '.minisig', flist) = 0 then iterate
    vv = .string[]
    vv[1] = 'minisign'
    vv[2] = '-V'
    vv[3] = '-q'
    vv[4] = '-P'
    vv[5] = signKey()
    vv[6] = '-m'
    vv[7] = dir || '/' || f || '.new'
    vv[8] = '-x'
    vv[9] = dir || '/' || f || '.minisig.new'
    x = exec(vv)
    if lastrc \= 0 then return 'FAIL ' || f
  end
  if unsigned > 0 then return 'UNSIGNED'
  return 'OK'

stampCheck: procedure = .void
  arg latest = .string, minv = .string
  call writeText(home || '/clientcheck.txt', 'DATE: ' || date('STANDARD') || NL || 'LATEST: ' || latest || NL || 'MIN: ' || minv || NL)
  return

checkClientUpdate: procedure = .void
  if upper(getConfig('CLIENT_CHECK')) = 'OFF' then return
  if getenv('RXPIP_NO_UPDATE_CHECK') \= '' then return
  today = date('STANDARD')
  f = home || '/clientcheck.txt'
  latest = ''
  minv = ''
  if fileExists(f) = 1 then do
    txt = readAll(f)
    if stanzaField(txt, 'DATE') = today then do
      latest = stanzaField(txt, 'LATEST')
      minv = stanzaField(txt, 'MIN')
    end
  end
  if latest = '' then do
    m = serverGet('CLIENT', 'kind=crexx')
    if stanzaField(m, 'STATUS') = 'OK' then do
      latest = stanzaField(m, 'LATEST')
      minv = stanzaField(m, 'MIN')
    end
    call stampCheck(latest, minv)
  end
  cur = clientVersion()
  if latest = '' then return
  if compareVersions(latest, cur) <= 0 then return
  if getConfig('AUTOUPDATE') = '1' then do
    r = doUpdate(0, 1)
    if r = 0 then do
      say 'rxpip: updated to ' || latest || ' (run the command again to use it)'
      exit 0
    end
    return
  end
  if minv \= '' & compareVersions(cur, minv) < 0 then do
    say 'rxpip: this client (' || cur || ') is too old for the server (needs ' || minv || '). Run: rxpip update'
    return
  end
  say 'rxpip: version ' || latest || ' is available (you have ' || cur || '). Run: rxpip update'
  return

/* rxpip admin stats [--days=N] | users | lock <user> |
              client-publish <kind> --version=V [--min=V] <file>... */
cmdAdmin: procedure = .int
  arg a = .string[]
  sub = ''
  if a.0 > 0 then sub = upper(a[1])
  t = resolveToken(a)
  if sub = '' | wordpos(sub, 'STATS USERS LOCK CLIENT-PUBLISH') = 0 then do
    say 'usage: rxpip admin stats [--days=N] | users | lock <user> | client-publish <kind> --version=V [--min=V] <file>...'
    return 1
  end
  if t = '' then do
    say 'not logged in (rxpip login --token=T)'
    return 1
  end
  sec = .string[]
  sec[1] = 'X-Rxpip-Token: ' || t
  hdrs = .string[]
  out = ''
  if sub = 'STATS' then do
    days = opt(a, 'days')
    if days \= '' then hdrs[1] = 'X-Rxpip-Days: ' || days
    out = serverPost('ADMINSTATS', '', hdrs, sec, '')
  end
  else if sub = 'USERS' then out = serverPost('ADMINUSERS', '', hdrs, sec, '')
  else if sub = 'LOCK' then do
    u = ''
    if a.0 > 1 then u = a[2]
    if u = '' | left(u, 2) = '--' then do
      say 'usage: rxpip admin lock <user>'
      return 1
    end
    hdrs[1] = 'X-Rxpip-User: ' || u
    out = serverPost('ADMINLOCK', '', hdrs, sec, '')
  end
  else do
    kind = ''
    if a.0 > 1 then kind = a[2]
    ver = opt(a, 'version')
    minv = opt(a, 'min')
    dir = ''
    tarv = .string[]
    n = 0
    n = n + 1; tarv[n] = 'tar'
    n = n + 1; tarv[n] = 'czf'
    tgz = home || '/rel_' || pid() || '.tgz'
    n = n + 1; tarv[n] = tgz
    n = n + 1; tarv[n] = '-C'
    n = n + 1; tarv[n] = '.'
    ndirpos = n
    nfiles = 0
    do i = 3 to a.0
      w = a[i]
      if left(w, 2) = '--' then iterate
      if fileExists(w) = 0 then do
        say 'rxpip: no such file: ' || w
        return 1
      end
      w = translate(w, '/', '5C'x)
      q = lastpos('/', w)
      d = '.'
      if q > 1 then d = substr(w, 1, q - 1)
      if q = 1 then d = '/'
      if nfiles > 0 & d \= dir then do
        say 'rxpip: all release files must be in one directory'
        return 1
      end
      dir = d
      nfiles = nfiles + 1
      n = n + 1; tarv[n] = baseName(w)
    end
    if kind = '' | left(kind, 2) = '--' | ver = '' | nfiles = 0 then do
      say 'usage: rxpip admin client-publish <kind> --version=V [--min=V] <file>...'
      return 1
    end
    tarv[ndirpos] = dir
    x = exec(tarv)
    hdrs[1] = 'X-Rxpip-Kind: ' || kind
    hdrs[2] = 'X-Rxpip-Version: ' || ver
    if minv \= '' then hdrs[3] = 'X-Rxpip-Min: ' || minv
    out = serverPost('ADMINCLIENT', '', hdrs, sec, tgz)
    call rmfile(tgz)
  end
  return showResponse(out)

/* =====================================================================
   HTTP (curl)
   ===================================================================== */
serverGet: procedure = .string
  arg action = .string, extra = .string
  url = repoUrl || '?action=' || action
  if extra \= '' then url = url || '&' || extra
  argv = .string[]
  argv[1] = 'curl'
  argv[2] = '-s'
  argv[3] = '-H'
  argv[4] = clientHdr
  argv[5] = url
  if readToken \= '' then do
    hf = home || '/rhdr_' || pid() || '.tmp'
    call writePrivate(hf, 'X-Rxpip-Token: ' || readToken || NL || NL)
    argv[5] = '-H'
    argv[6] = '@' || hf
    argv[7] = url
    res = exec(argv)
    call rmfile(hf)
    return res
  end
  return exec(argv)

serverDownload: procedure = .int
  arg name = .string, ver = .string, kind = .string, platform = .string, outfile = .string
  url = repoUrl || '?action=DOWNLOAD&name=' || urlEnc(name)
  if ver \= '' then url = url || '&version=' || urlEnc(ver)
  url = url || '&kind=' || urlEnc(kind) || '&platform=' || urlEnc(platform)
  argv = .string[]
  argv[1] = 'curl'
  argv[2] = '-s'
  argv[3] = '-f'
  argv[4] = '-o'
  argv[5] = outfile
  argv[6] = '-H'
  argv[7] = clientHdr
  argv[8] = url
  if readToken \= '' then do
    hf = home || '/rhdr_' || pid() || '.tmp'
    call writePrivate(hf, 'X-Rxpip-Token: ' || readToken || NL || NL)
    argv[8] = '-H'
    argv[9] = '@' || hf
    argv[10] = url
    tmp = exec(argv)
    call rmfile(hf)
    return lastrc
  end
  tmp = exec(argv)
  return lastrc

/* POST. hdrs: ordinary "Name: value" headers; secrets: header lines that
   must not appear in the URL or on a command ln, so they go to curl
   through a private temporary file (curl -H @file). bodyfile may be ''. */
serverPost: procedure = .string
  arg action = .string, extra = .string, hdrs = .string[], secrets = .string[], bodyfile = .string
  url = repoUrl || '?action=' || action
  if extra \= '' then url = url || '&' || extra
  hf = home || '/hdr_' || pid() || '.tmp'
  content = ''
  do i = 1 to secrets.0
    content = content || secrets[i] || NL
  end
  content = content || NL
  call writePrivate(hf, content)
  argv = .string[]
  n = 0
  n = n + 1; argv[n] = 'curl'
  n = n + 1; argv[n] = '-s'
  n = n + 1; argv[n] = '-X'
  n = n + 1; argv[n] = 'POST'
  n = n + 1; argv[n] = '-H'
  n = n + 1; argv[n] = clientHdr
  n = n + 1; argv[n] = '-H'
  n = n + 1; argv[n] = '@' || hf
  do i = 1 to hdrs.0
    n = n + 1; argv[n] = '-H'
    n = n + 1; argv[n] = hdrs[i]
  end
  if bodyfile \= '' then do
    n = n + 1; argv[n] = '--data-binary'
    n = n + 1; argv[n] = '@' || bodyfile
  end
  else do
    n = n + 1; argv[n] = '-d'
    n = n + 1; argv[n] = ''
  end
  n = n + 1; argv[n] = url
  out = exec(argv)
  call rmfile(hf)
  return out

showResponse: procedure = .int
  arg out = .string
  say out
  if out = '' then do
    say 'rxpip: no response from server'
    return 1
  end
  if word(out, 1) = 'STATUS:' & word(out, 2) = 'OK' then return 0
  return 1

/* =====================================================================
   NATIVE ARTIFACTS  (platform builds, system prerequisites, plugins)
   ---------------------------------------------------------------------
   A package version can carry, besides its SOURCE/crexx artifact, NATIVE
   artifacts: one per platform tag (crexx-<os>-<arch>) and interface level
   (ABI, e.g. rxpa1). The client installs the source plus the native build
   that matches this system, or refuses with a clear message.
   Layout convention inside a package (all optional):
     providers/   RXPA provider plugins   -> rxvm --provider-path
     libs/        shared libraries        -> LD_LIBRARY_PATH / DYLD_ / PATH
     share/ ...   data, docs, licences    -> RXPIP_PKG_<NAME> points at the
                                             package directory
   ===================================================================== */
osName: procedure = .string
  os = 'unknown'
  out = .string[]
  address crexx "platform" output out
  do i = 1 to out.0
    if left(out[i], 3) = 'os=' then os = lower(strip(substr(out[i], 4)))
  end
  return os

platformTag: procedure = .string
  os = 'unknown'
  arch = 'unknown'
  out = .string[]
  address crexx "platform" output out
  do i = 1 to out.0
    if left(out[i], 3) = 'os=' then os = lower(strip(substr(out[i], 4)))
    if left(out[i], 5) = 'arch=' then arch = lower(strip(substr(out[i], 6)))
  end
  if arch = 'amd64' | arch = 'x64' then arch = 'x86_64'
  if arch = 'arm64' then arch = 'aarch64'
  return lang || '-' || os || '-' || arch

supportedAbis: procedure = .string
  v = getenv('RXPIP_ABI')
  if v = '' then v = getConfig('NATIVE_ABI')
  if v = '' then v = 'rxpa1'
  return translate(lower(v), ' ', ',')

cmdPlatform: procedure = .void
  say platformTag()
  say 'abi:' supportedAbis()
  return

/* the ARTIFACTS response as one record per artifact:
   kind SOH platform SOH files SOH tree SOH abi SOH runtime SOH build */
artifactRecords: procedure = .string[]
  arg resp = .string
  res = .string[]
  n = 0
  k = ''
  p = ''
  f = ''
  t = ''
  ab = ''
  rt = ''
  bt = ''
  txt = resp
  do while txt \= ''
    ln = nextLine(txt)
    if ln = '' then do
      if k \= '' then do
        n = n + 1
        res[n] = k || SOH || p || SOH || f || SOH || t || SOH || ab || SOH || rt || SOH || bt
      end
      k = ''
      p = ''
      f = ''
      t = ''
      ab = ''
      rt = ''
      bt = ''
    end
    else if left(ln, 5) = 'KIND:' then k = strip(substr(ln, 6))
    else if left(ln, 9) = 'PLATFORM:' then p = strip(substr(ln, 10))
    else if left(ln, 6) = 'FILES:' then f = strip(substr(ln, 7))
    else if left(ln, 5) = 'TREE:' then t = strip(substr(ln, 6))
    else if left(ln, 4) = 'ABI:' then ab = strip(substr(ln, 5))
    else if left(ln, 17) = 'RUNTIME-REQUIRES:' then rt = strip(substr(ln, 18))
    else if left(ln, 15) = 'BUILD-REQUIRES:' then bt = strip(substr(ln, 16))
  end
  if k \= '' then do
    n = n + 1
    res[n] = k || SOH || p || SOH || f || SOH || t || SOH || ab || SOH || rt || SOH || bt
  end
  return res

/* field number idx (1-based) of a SOH-separated record */
recField: procedure = .string
  arg rec = .string, idx = .int
  txt = rec
  do i = 1 to idx - 1
    q = pos(SOH, txt)
    if q = 0 then return ''
    txt = substr(txt, q + 1)
  end
  q = pos(SOH, txt)
  if q = 0 then return txt
  return substr(txt, 1, q - 1)

/* the SOURCE artifact for this language, or '' */
pickBase: procedure = .string
  arg recs = .string[]
  do i = 1 to recs.0
    if upper(recField(recs[i], 1)) = 'SOURCE' & lower(recField(recs[i], 2)) = lang then return recs[i]
  end
  return ''

/* the NATIVE artifact for this system (platform tag and a supported ABI);
   the ABI listed first in supportedAbis() wins; '' if none fits */
pickNative: procedure = .string
  arg recs = .string[]
  tag = platformTag()
  abis = supportedAbis()
  best = ''
  bestRank = 9999
  do i = 1 to recs.0
    if upper(recField(recs[i], 1)) = 'NATIVE' & lower(recField(recs[i], 2)) = tag then do
      ab = lower(recField(recs[i], 5))
      rank = 5000
      if ab \= '' then rank = wordpos(ab, abis)
      if ab = '' | rank > 0 then do
        if rank < bestRank then do
          best = recs[i]
          bestRank = rank
        end
      end
    end
  end
  return best

/* "platform/abi platform/abi ..." for every NATIVE artifact, '' if none */
nativeSummary: procedure = .string
  arg recs = .string[]
  out = ''
  do i = 1 to recs.0
    if upper(recField(recs[i], 1)) = 'NATIVE' then do
      ab = recField(recs[i], 5)
      if ab = '' then ab = 'any-abi'
      out = out || ' ' || recField(recs[i], 2) || '/' || ab
    end
  end
  return strip(out)

artLabel: procedure = .string
  arg base = .string, nat = .string
  res = ''
  if base \= '' then res = recField(base, 1) || '/' || recField(base, 2)
  if nat \= '' then do
    if res \= '' then res = res || ' + '
    res = res || recField(nat, 1) || '/' || recField(nat, 2)
  end
  return res

/* a space-separated list without repeated words */
dedupe: procedure = .string
  arg w = .string
  out = ''
  do i = 1 to words(w)
    if wordpos(word(w, i), out) = 0 then out = out word(w, i)
  end
  return strip(out)

safeWord: procedure = .int
  arg s = .string
  ok = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._+-'
  if s = '' then return 0
  do i = 1 to length(s)
    if pos(substr(s, i, 1), ok) = 0 then return 0
  end
  return 1

/* the prerequisites in reqs ("pkg:NAME[>=VER]", "lib:NAME", "cmd:NAME")
   that this system lacks, as "entry (why); entry (why)"; '' if all there */
runtimeMissing: procedure = .string
  arg reqs = .string
  miss = ''
  do i = 1 to words(reqs)
    w = word(reqs, i)
    why = prereqProblem(w)
    if why \= '' then do
      if miss \= '' then miss = miss || '; '
      miss = miss || w || ' (' || why || ')'
    end
  end
  return miss

/* '' if the prerequisite is satisfied, else why not */
prereqProblem: procedure = .string
  arg w = .string
  c = pos(':', w)
  if c < 2 then return 'not a valid entry'
  kd = lower(substr(w, 1, c - 1))
  nm = substr(w, c + 1)
  ver = ''
  q = pos('>=', nm)
  if q > 0 then do
    ver = substr(nm, q + 2)
    nm = substr(nm, 1, q - 1)
  end
  if safeWord(nm) = 0 then return 'not a valid name'
  if ver \= '' then do
    if safeWord(ver) = 0 then return 'not a valid version'
  end
  win = 0
  if getenv('OS') = 'Windows_NT' then win = 1
  argv = .string[]
  if kd = 'pkg' then do
    argv[1] = 'pkg-config'
    argv[2] = '--version'
    x = exec(argv)
    if lastrc \= 0 then return 'pkg-config is not installed, so it cannot be checked'
    argv = .string[]
    argv[1] = 'pkg-config'
    if ver = '' then do
      argv[2] = '--exists'
      argv[3] = nm
    end
    else do
      argv[2] = '--atleast-version=' || ver
      argv[3] = nm
    end
    x = exec(argv)
    if lastrc = 0 then return ''
    if ver \= '' then return 'not found or older than ' || ver
    return 'not found'
  end
  if kd = 'cmd' then do
    if win = 1 then do
      argv[1] = 'cmd'
      argv[2] = '/c'
      argv[3] = 'where ' || nm || ' >nul 2>nul'
    end
    else do
      argv[1] = 'sh'
      argv[2] = '-c'
      argv[3] = 'command -v "$1" >/dev/null 2>&1'
      argv[4] = 'sh'
      argv[5] = nm
    end
    x = exec(argv)
    if lastrc = 0 then return ''
    return 'program not found'
  end
  if kd = 'lib' then do
    if win = 1 then do
      argv[1] = 'cmd'
      argv[2] = '/c'
      argv[3] = 'where ' || nm || '.dll >nul 2>nul'
    end
    else do
      argv[1] = 'sh'
      argv[2] = '-c'
      sc = 'case "$1" in lib*) p="$1";; *) p="lib$1";; esac; '
      sc = sc || 'for d in $(echo "$LD_LIBRARY_PATH:$DYLD_LIBRARY_PATH" | tr : " ") /usr/lib /usr/lib64 /usr/local/lib /lib /lib64 '
      sc = sc || '/usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /opt/homebrew/lib /opt/local/lib; do '
      sc = sc || 'for f in "$d/$p".so "$d/$p".so.* "$d/$p".dylib "$d/$p".*.dylib "$d/$p"; do [ -e "$f" ] && exit 0; done; done; '
      sc = sc || 'ldconfig -p 2>/dev/null | grep -q "$p\.so" && exit 0; exit 1'
      argv[3] = sc
      argv[4] = 'sh'
      argv[5] = nm
    end
    x = exec(argv)
    if lastrc = 0 then return ''
    return 'library not found'
  end
  return 'unknown kind (use pkg:, lib: or cmd:)'

/* check the installed packages in names; returns one line per problem, ''
   if everything is in place. build = 1 also checks the build tools. */
verifyInstalled: procedure = .string
  arg names = .string, build = .int
  bad = ''
  do i = 1 to words(names)
    nm = word(names, i)
    rec = findRecord(nm)
    if rec \= '' then do
      rt = stanzaField(rec, 'RUNTIME-REQUIRES')
      if rt \= '' & skipRt = 0 then do
        miss = runtimeMissing(rt)
        if miss \= '' then bad = bad || "rxpip: '" || nm || "' needs system prerequisites: " || miss || NL
      end
      if build = 1 then do
        bt = stanzaField(rec, 'BUILD-REQUIRES')
        if bt \= '' & skipRt = 0 then do
          miss = runtimeMissing(bt)
          if miss \= '' then bad = bad || "rxpip: '" || nm || "' needs build tools: " || miss || NL
        end
      end
    end
  end
  return bad

cmdCheck: procedure = .int
  recs = records()
  names = ''
  do i = 1 to recs.0
    names = names stanzaField(recs[i], 'NAME')
  end
  bad = verifyInstalled(strip(names), 1)
  if bad = '' then do
    say 'rxpip: all system prerequisites of the installed packages are in place'
    return 0
  end
  call charout , bad
  return 1

/* directory of an installed package (the store of this install scope) */
pkgDirOf: procedure = .string
  arg nm = .string
  v = installedVersion(nm)
  if v = '' then return ''
  return home || '/' || lang || '/pkgs/' || nm || '/' || v

/* the existing <pkgdir>/sub directories of the packages in names, joined by sep */
collectDirs: procedure = .string
  arg names = .string, sub = .string, sep = .string
  res = ''
  do i = 1 to words(names)
    d = pkgDirOf(word(names, i))
    if d \= '' then do
      if fileExists(d || '/' || sub) then do
        if res \= '' then res = res || sep
        res = res || d || '/' || sub
      end
    end
  end
  return res

envName: procedure = .string
  arg nm = .string
  return 'RXPIP_PKG_' || translate(upper(nm), '_', '-.')

/* run argv with extra environment variables (name=value entries) */
execEnv: procedure = .string
  arg argv = .string[], envs = .string[]
  if envs.0 = 0 then return exec(argv)
  full = .string[]
  n = 0
  if getenv('OS') = 'Windows_NT' then do
    cl = ''
    do i = 1 to envs.0
      cl = cl || 'set "' || envs[i] || '" && '
    end
    do i = 1 to argv.0
      cl = cl || '"' || argv[i] || '" '
    end
    n = n + 1; full[n] = 'cmd'
    n = n + 1; full[n] = '/c'
    n = n + 1; full[n] = cl
    return exec(full)
  end
  n = n + 1; full[n] = 'env'
  do i = 1 to envs.0
    n = n + 1; full[n] = envs[i]
  end
  do i = 1 to argv.0
    n = n + 1; full[n] = argv[i]
  end
  return exec(full)

/* the library search variable of this system */
libVar: procedure = .string
  os = osName()
  if os = 'darwin' | os = 'macos' then return 'DYLD_LIBRARY_PATH'
  if os = 'windows' | getenv('OS') = 'Windows_NT' then return 'PATH'
  return 'LD_LIBRARY_PATH'

pathSep: procedure = .string
  if libVar() = 'PATH' then return ';'
  return ':'

/* =====================================================================
   STANZAS, VERSIONS, ARTIFACTS
   ===================================================================== */
nextLine: procedure = .string
  arg expose txt = .string
  ln = ''
  p = pos(NL, txt)
  if p = 0 then do
    ln = txt
    txt = ''
  end
  else do
    ln = substr(txt, 1, p - 1)
    txt = substr(txt, p + 1)
  end
  return ln

stanzaField: procedure = .string
  arg resp = .string, key = .string
  tag = key || ':'
  txt = resp
  do while txt \= ''
    ln = nextLine(txt)
    if left(ln, length(tag)) = tag then return strip(substr(ln, length(tag) + 1))
  end
  return ''

printStanzas: procedure = .void
  arg resp = .string
  txt = resp
  do while txt \= ''
    ln = nextLine(txt)
    if ln = 'STATUS: OK' then iterate
    if left(ln, 6) = 'COUNT:' then iterate
    say ln
  end
  return

infoMessage: procedure = .string
  arg resp = .string
  m = stanzaField(resp, 'MESSAGE')
  if m = '' then m = 'no response from server'
  return m

withVer: procedure = .string
  arg v = .string
  if v = '' then return ''
  return '&version=' || urlEnc(v)

compareVersions: procedure = .int
  arg a = .string, b = .string
  aa = translate(a, ' ', '.')
  bb = translate(b, ' ', '.')
  n = words(aa)
  if words(bb) > n then n = words(bb)
  do i = 1 to n
    x = 0
    y = 0
    if i <= words(aa) then x = word(aa, i) + 0
    if i <= words(bb) then y = word(bb, i) + 0
    if x < y then return -1
    if x > y then return 1
  end
  return 0

/* the artifact to install: SOURCE/<lang> (this client's language) */
urlEnc: procedure = .string
  arg s = .string
  out = ''
  do i = 1 to length(s)
    c = substr(s, i, 1)
    if verify(c, 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.~-') = 0 then out = out || c
    else out = out || '%' || c2x(c)
  end
  return out

opt: procedure = .string
  arg a = .string[], key = .string
  needle = '--' || key || '='
  do i = 1 to a.0
    if left(a[i], length(needle)) = needle then return substr(a[i], length(needle) + 1)
  end
  return ''

/* =====================================================================
   INSTALLED-PACKAGE DATABASE  (<home>/crexx/installed.txt, same record
   format as the other clients: NAME/VERSION/AUTHOR/SUMMARY/REQUIRES/FILES)
   ===================================================================== */
records: procedure = .string[]
  return recordsAt(recDir)

recordsAt: procedure = .string[]
  arg dir = .string
  res = .string[]
  idx = dir || '/installed.txt'
  if \fileExists(idx) then return res
  lines = readlines(idx)
  cur = ''
  n = 0
  do i = 1 to lines.0
    if lines[i] = '' then do
      if cur \= '' then do
        n = n + 1
        res[n] = cur
      end
      cur = ''
    end
    else cur = cur || lines[i] || NL
  end
  if cur \= '' then do
    n = n + 1
    res[n] = cur
  end
  return res

findRecord: procedure = .string
  arg name = .string
  recs = records()
  do i = 1 to recs.0
    if stanzaField(recs[i], 'NAME') = name then return recs[i]
  end
  return ''

installedVersion: procedure = .string
  arg name = .string
  rec = findRecord(name)
  if rec = '' then return ''
  return stanzaField(rec, 'VERSION')

removeRecord: procedure = .void
  arg name = .string
  recs = records()
  out = ''
  do i = 1 to recs.0
    if stanzaField(recs[i], 'NAME') \= name then out = out || recs[i] || NL
  end
  if out = '' then call rmfile(recDir || '/installed.txt')
  else call writeText(recDir || '/installed.txt', out)
  return

recordInstalled: procedure = .void
  arg name = .string, ver = .string, author = .string, summary = .string, requires = .string, files = .string, extra = .string
  call removeRecord(name)
  call mkdirs(recDir)
  idx = recDir || '/installed.txt'
  cur = ''
  if fileExists(idx) then cur = loadtext(idx, NL)
  cur = cur || 'NAME: ' || name || NL || 'VERSION: ' || ver || NL || 'AUTHOR: ' || author || NL || 'SUMMARY: ' || summary || NL || 'REQUIRES: ' || requires || NL || 'FILES: ' || files || NL || extra || NL
  call writeText(idx, cur)
  return

/* =====================================================================
   SYSTEM LAYER  (files and processes)
   ===================================================================== */
/* run a program with an argument vector; returns stdout (+stderr) as text,
   sets lastrc */
exec: procedure = .string
  arg argv = .string[]
  out = .string[]
  err = .string[]
  address crexx "run :argv[]" output out error err
  lastrc = rc
  res = ''
  do i = 1 to out.0
    res = res || out[i] || NL
  end
  do i = 1 to err.0
    res = res || err[i] || NL
  end
  return res

pid: procedure = .string
  out = .string[]
  address crexx "pid" output out
  if out.0 > 0 then return strip(out[1])
  return '0'

fileExists: procedure = .int
  arg f = .string
  ao = .string[]
  ae = .string[]
  address crexx "exists :f" output ao error ae
  if rc = 0 then return 1
  return 0

mkdirs: procedure = .void
  arg d = .string
  ao = .string[]
  ae = .string[]
  address crexx "mkdir -p :d" output ao error ae
  return

rmfile: procedure = .void
  arg f = .string
  ao = .string[]
  ae = .string[]
  address crexx "rm :f" output ao error ae
  return

rmtree: procedure = .void
  arg d = .string
  if fileExists(d) then do
    ao = .string[]
    ae = .string[]
    address crexx "rm -r :d" output ao error ae
  end
  return

copyFile: procedure = .void
  arg src = .string, dst = .string
  ao = .string[]
  ae = .string[]
  address crexx "cp :src :dst" output ao error ae
  return

baseName: procedure = .string
  arg p = .string
  q = lastpos('/', p)
  if q = 0 then return p
  return substr(p, q + 1)

listDir: procedure = .string[]
  arg d = .string
  out = .string[]
  address crexx "ls :d" output out
  return out

/* write a text file (replaces it) */
writeText: procedure = .void
  arg f = .string, content = .string
  tmp = f || '.new'
  call rmfile(tmp)
  ao = .string[]
  ae = .string[]
  address crexx "touch :tmp" output ao error ae
  txt = content
  wrote = 0
  do while txt \= ''
    ln = nextLine(txt)
    call lineout tmp, ln
    wrote = 1
  end
  if wrote then call lineout tmp
  address crexx "mv :tmp :f" output ao error ae
  return

/* write a file only the owner can read (mode 600 on Unix) */
writePrivate: procedure = .void
  arg f = .string, content = .string
  tmp = f || '.new'
  call rmfile(tmp)
  ao = .string[]
  ae = .string[]
  address crexx "touch :tmp" output ao error ae
  argv = .string[]
  argv[1] = 'chmod'
  argv[2] = '600'
  argv[3] = tmp
  x = exec(argv)
  txt = content
  wrote = 0
  do while txt \= ''
    ln = nextLine(txt)
    call lineout tmp, ln
    wrote = 1
  end
  if wrote then call lineout tmp
  address crexx "mv :tmp :f" output ao error ae
  return
